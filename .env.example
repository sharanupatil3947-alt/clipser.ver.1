# Clipser Platform Environment Variables
PROJECT_NAME=Clipser
SECRET_KEY=generate_your_secure_random_key_here
DATABASE_URL=sqlite:///./clipser.db

# Storage Directory
STORAGE_DIR=./storage

# Google OAuth (Optional - enable Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Gemini Flash API (Optional for LLM Hook Generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
